// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  phone               String             @unique
  passwordHash        String             @map("password_hash")
  role                UserRole           @default(CUSTOMER)
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  profile          UserProfile?
  serviceProvider  ServiceProvider?
  customerBookings Booking[] @relation("CustomerBookings")
  sentMessages     Message[]
  reviewsGiven     Review[]  @relation("ReviewsGiven")
  reviewsReceived  Review[]  @relation("ReviewsReceived")

  @@map("users")
}

model UserProfile {
  userId               String  @id @map("user_id")
  firstName            String  @map("first_name")
  lastName             String  @map("last_name")
  avatarUrl            String? @map("avatar_url")
  language             String  @default("en")
  address              Json?
  notificationSettings Json?   @map("notification_settings")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Service Provider Domain
model ServiceProvider {
  userId              String   @id @map("user_id")
  businessName        String   @map("business_name")
  description         String?
  services            String[]
  serviceAreas        Json     @map("service_areas")
  pricing             Json?
  availability        Json?
  rating              Decimal  @default(0) @db.Decimal(2, 1)
  completedJobs       Int      @default(0) @map("completed_jobs")
  responseTimeMinutes Int      @default(0) @map("response_time_minutes")
  isActive            Boolean  @default(false) @map("is_active")

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationDocuments  VerificationDocument[]
  bookings               Booking[]

  @@map("service_providers")
}

model VerificationDocument {
  id           String             @id @default(cuid())
  providerId   String             @map("provider_id")
  documentType DocumentType       @map("document_type")
  fileUrl      String             @map("file_url")
  status       VerificationStatus @default(PENDING)
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewedBy   String?            @map("reviewed_by")
  expiryDate   DateTime?          @map("expiry_date")
  createdAt    DateTime           @default(now()) @map("created_at")

  // Relations
  provider ServiceProvider @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@map("verification_documents")
}

// Booking & Transaction Domain
model Booking {
  id                   String         @id @default(cuid())
  customerId           String         @map("customer_id")
  providerId           String         @map("provider_id")
  serviceDetails       Json           @map("service_details")
  serviceLocation      Json           @map("service_location")
  scheduledAt          DateTime       @map("scheduled_at")
  durationMinutes      Int?           @map("duration_minutes")
  status               BookingStatus  @default(PENDING)
  pricing              Json
  specialInstructions  String?        @map("special_instructions")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  // Relations
  customer       User           @relation("CustomerBookings", fields: [customerId], references: [id])
  provider       ServiceProvider @relation(fields: [providerId], references: [userId])
  paymentRecord  PaymentRecord?
  messages       Message[]
  reviews        Review[]

  @@map("bookings")
}

model PaymentRecord {
  id                    String        @id @default(cuid())
  bookingId             String        @unique @map("booking_id")
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @map("platform_fee") @db.Decimal(10, 2)
  providerPayout        Decimal       @map("provider_payout") @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  paymentGateway        String        @map("payment_gateway")
  gatewayTransactionId  String?       @map("gateway_transaction_id")
  escrowReleaseAt       DateTime?     @map("escrow_release_at")
  createdAt             DateTime      @default(now()) @map("created_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("payment_records")
}

// Communication
model Message {
  id          String      @id @default(cuid())
  bookingId   String      @map("booking_id")
  senderId    String      @map("sender_id")
  content     String
  messageType MessageType @default(TEXT) @map("message_type")
  attachments Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Reviews & Ratings
model Review {
  id         String   @id @default(cuid())
  bookingId  String   @map("booking_id")
  reviewerId String   @map("reviewer_id")
  revieweeId String   @map("reviewee_id")
  rating     Int      @db.SmallInt
  comment    String?
  photos     String[]
  isVerified Boolean  @default(true) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User    @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Enums
enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  POLICE_CLEARANCE
  NATIONAL_ID
  BUSINESS_REGISTRATION
  PROFESSIONAL_CERTIFICATE
  INSURANCE
  TAX_REGISTRATION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  ESCROW_HELD
  RELEASED
  REFUNDED
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}
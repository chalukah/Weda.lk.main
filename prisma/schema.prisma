// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  phone               String             @unique
  passwordHash        String             @map("password_hash")
  role                UserRole           @default(CUSTOMER)
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  // Relations
  profile              UserProfile?
  serviceProvider      ServiceProvider?
  subscription         Subscription?
  customerConnections  ServiceConnection[] @relation("CustomerConnections")
  sentMessages         Message[]
  reviewsGiven         Review[]  @relation("ReviewsGiven")
  reviewsReceived      Review[]  @relation("ReviewsReceived")

  @@map("users")
}

model UserProfile {
  userId               String  @id @map("user_id")
  firstName            String  @map("first_name")
  lastName             String  @map("last_name")
  avatarUrl            String? @map("avatar_url")
  language             String  @default("en")
  address              Json?
  notificationSettings Json?   @map("notification_settings")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Service Provider Domain
model ServiceProvider {
  userId              String   @id @map("user_id")
  businessName        String   @map("business_name")
  description         String?
  services            String[]
  serviceAreas        Json     @map("service_areas")
  pricing             Json?
  availability        Json?
  rating              Decimal  @default(0) @db.Decimal(2, 1)
  completedJobs       Int      @default(0) @map("completed_jobs")
  responseTimeMinutes Int      @default(0) @map("response_time_minutes")
  isActive            Boolean  @default(false) @map("is_active")
  contactInfo         Json?    @map("contact_info")

  // Relations
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationDocuments  VerificationDocument[]
  serviceConnections     ServiceConnection[]

  @@map("service_providers")
}

model VerificationDocument {
  id           String             @id @default(cuid())
  providerId   String             @map("provider_id")
  documentType DocumentType       @map("document_type")
  fileUrl      String             @map("file_url")
  status       VerificationStatus @default(PENDING)
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewedBy   String?            @map("reviewed_by")
  expiryDate   DateTime?          @map("expiry_date")
  createdAt    DateTime           @default(now()) @map("created_at")

  // Relations
  provider ServiceProvider @relation(fields: [providerId], references: [userId], onDelete: Cascade)

  @@map("verification_documents")
}

// Service Connection Domain (No payment processing)
model ServiceConnection {
  id                   String                @id @default(cuid())
  customerId           String                @map("customer_id")
  providerId           String                @map("provider_id")
  serviceDetails       Json                  @map("service_details")
  serviceLocation      Json                  @map("service_location")
  scheduledAt          DateTime?             @map("scheduled_at")
  durationMinutes      Int?                  @map("duration_minutes")
  status               ServiceConnectionStatus @default(REQUESTED)
  agreedPrice          Decimal?              @map("agreed_price") @db.Decimal(10, 2)
  specialInstructions  String?               @map("special_instructions")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  // Relations
  customer User            @relation("CustomerConnections", fields: [customerId], references: [id])
  provider ServiceProvider @relation(fields: [providerId], references: [userId])
  messages Message[]
  reviews  Review[]

  @@map("service_connections")
}

// Service transactions are now free - no payment records needed
// Users pay only for platform access via subscriptions

model Subscription {
  id              String             @id @default(cuid())
  userId          String             @unique @map("user_id")
  planId          String             @map("plan_id")
  status          SubscriptionStatus @default(TRIAL)
  startDate       DateTime           @map("start_date")
  endDate         DateTime           @map("end_date")
  nextBillingDate DateTime           @map("next_billing_date")
  autoRenew       Boolean            @default(false) @map("auto_renew")
  paymentMethod   String?            @map("payment_method")
  lastPaymentDate DateTime?          @map("last_payment_date")
  paymentProof    String?            @map("payment_proof")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Communication
model Message {
  id             String      @id @default(cuid())
  connectionId   String      @map("connection_id")
  senderId       String      @map("sender_id")
  content        String
  messageType    MessageType @default(TEXT) @map("message_type")
  attachments    Json?
  createdAt      DateTime    @default(now()) @map("created_at")

  // Relations
  connection ServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  sender     User              @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// Reviews & Ratings
model Review {
  id             String   @id @default(cuid())
  connectionId   String   @map("connection_id")
  reviewerId     String   @map("reviewer_id")
  revieweeId     String   @map("reviewee_id")
  rating         Int      @db.SmallInt
  comment        String?
  photos         String[]
  isVerified     Boolean  @default(true) @map("is_verified")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  connection ServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviewer   User              @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee   User              @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// Enums
enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentType {
  POLICE_CLEARANCE
  NATIONAL_ID
  BUSINESS_REGISTRATION
  PROFESSIONAL_CERTIFICATE
  INSURANCE
  TAX_REGISTRATION
}

// Removed BookingStatus - replaced with ServiceConnectionStatus

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
  PAYMENT_PENDING
}

enum ServiceConnectionStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}
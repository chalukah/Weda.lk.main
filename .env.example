# 🆓 Weda.lk FREE TIER Environment Variables
# Copy this file to .env.local and fill in your actual values

# =======================
# 🔒 SECURITY
# =======================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-32-char-secret-here
NEXTAUTH_URL=http://localhost:3000

# =======================
# 🗄️ DATABASE (FREE: Supabase - 500MB)
# =======================
# From Supabase project settings > Database > Connection string
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# =======================
# 🏃‍♂️ CACHE (FREE: Upstash - 10K requests/day)
# =======================
# From Upstash dashboard > Database > REST URL
REDIS_URL=https://your-endpoint.upstash.io

# =======================
# 🔑 AUTHENTICATION
# =======================
# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=123456789-abcdefgh.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret-key

# =======================
# 📁 FILE STORAGE (FREE: Cloudinary - 25GB)
# =======================
# From Cloudinary dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-secret-key

# =======================
# 🗺️ MAPS & LOCATION (FREE: $200 credit/month)
# =======================
# From Google Cloud Console > APIs & Services > Credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your-google-places-api-key

# =======================
# 💳 PAYMENT GATEWAY (FREE: Stripe - no monthly fees)
# =======================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# =======================
# 📧 EMAIL (FREE: Resend - 3000 emails/month)
# =======================
# From Resend dashboard > API Keys
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@weda.lk

# =======================
# 📊 MONITORING (FREE: Sentry - 5K errors/month)
# =======================
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# =======================
# 🌐 EXTERNAL APIS
# =======================
# Exchange Rate API (for currency conversion)
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Police Verification API (Custom Sri Lankan service)
POLICE_VERIFICATION_API_KEY=your-police-api-key
POLICE_VERIFICATION_BASE_URL=https://api.police.lk/v1

# =======================
# 🔧 DEVELOPMENT
# =======================
NODE_ENV=development
LOG_LEVEL=debug

# =======================
# 💰 PAID UPGRADE OPTIONS (Uncomment when scaling)
# =======================
# AWS S3 (when Cloudinary limits exceeded)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET_NAME=weda-lk-uploads

# Twilio SMS (when SMS verification needed)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+94712345678

# PayHere (for Sri Lankan market)
# PAYHERE_MERCHANT_ID=your-payhere-merchant-id
# PAYHERE_MERCHANT_SECRET=your-payhere-secret
# PAYHERE_SANDBOX=true

# SendGrid (when Resend limits exceeded)
# SENDGRID_API_KEY=SG.your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@weda.lk
# SENDGRID_FROM_NAME=Weda.lk
